<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cardex.weekly-refresh</string>

    <!-- What to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nathan/Desktop/cardex/scripts/weekly_refresh.sh</string>
    </array>

    <!-- When: every Monday at 6am local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Where stdout/stderr go (the script also tee's to logs/ inside the repo) -->
    <key>StandardOutPath</key>
    <string>/Users/nathan/Desktop/cardex/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nathan/Desktop/cardex/logs/launchd-stderr.log</string>

    <!-- Run from repo root so relative paths resolve -->
    <key>WorkingDirectory</key>
    <string>/Users/nathan/Desktop/cardex</string>

    <!-- Don't run if the previous run is still going -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
